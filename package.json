{
  "name": "rift-rails",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8000",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit --skipLibCheck",
    "lint": "oxlint --type-aware",
    "format": "oxfmt src tests scripts vite.config.ts svelte.config.js playwright.config.ts",
    "format:check": "oxfmt --check src tests scripts vite.config.ts svelte.config.js playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@typescript/native": "npm:typescript@^7.0.0",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3"
  }
}
