{
  "name": "rift-rails",
  "private": true,
  "type": "module",
  "scripts": {
    "plugins:build": "node scripts/build-plugins.mjs",
    "audio:sonic-pi": "node scripts/fetch-sonic-pi.mjs",
    "predev": "node scripts/fetch-sonic-pi.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-sonic-pi.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8000",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 8100",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "oxlint",
    "format": "oxfmt src tests scripts vite.config.ts playwright.config.ts",
    "format:check": "oxfmt --check src tests scripts vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "jszip": "^3.10.2"
  }
}
